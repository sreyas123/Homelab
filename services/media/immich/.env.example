# Copy this file to a file named .env and fill it in. Never share the .env file.
# (Put your own folder for uploaded photos here, or keep this default)
UPLOAD_LOCATION=./library
# (Put your own folder for the database here, or keep this default)
DB_DATA_LOCATION=./postgres
# (Put your own time zone here, for example Europe/London)
TZ=Your/Timezone
IMMICH_VERSION=release
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# (Put your own password here - invent one, letters and numbers only)
DB_PASSWORD=
